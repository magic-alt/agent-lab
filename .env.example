# Required only for online OpenAI experiments.
OPENAI_API_KEY=

# Intentionally no hard-coded default model: choose one available to your API project.
AGENT_LAB_MODEL=

# Optional. Online traces from the OpenAI Agents SDK are not used in Phase 00-04;
# agent-lab writes local JSONL traces by default.
AGENT_LAB_TRACE_DIR=runs
